# ─────────────────────────────────────────────────────────────────────────────
# AegisDAO IntentLock — Sepolia / local configuration
# Copy to .env (gitignored) and fill in. Never prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# RPC + explorer
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/FHB0zu49ESkJcQVatK3Li
ETHERSCAN_API_KEY=QEDVUTKHD96RD5RXW8RHYBY2FMFK7GIPW3
# Deployer: funds deployment, mints demo tokens, sends force-execute attempts.
DEPLOYER_KEY=00658ab558bf712a46326e5818608d29b431f789f262f0d117e82c93ced05a2f

# Demo roles. Addresses are derived from the keys; *_ADDRESS overrides exist
# when a role is a multisig or a wallet you do not control here.
PROPOSER_KEY=bd1c90d54cd94479c95239c39f128d1a43a8a6860c652892b64f8270aa334bb7
VOTER1_KEY=8b50e8de4d13ad05f4d1adc3edbb8d43c027ba9c4fd628f6c8be874a728942b7
VOTER2_KEY=708ea038b7909d85e4fa78d7c3cbf383f16afbad55b936a365a546fd4c5a3d44
VOTER3_KEY=e38669445c02b75b734c5a81c95616e8486742339718297f1fb212611698447b
GUARDIAN_KEY=2e82b36ad46befcd2fc3863b4242dc895fa1eea996d7c255fcd1d977d03755f7
VERIFIER_KEY=3df4b0f26d100d12d1bafaa727dc8f3a8d15b4b088f3af661244ad3a409978fe
CHALLENGER_KEY=e94b96adb39bc3bc58b27c78553d4f4519a4360bda3ad6c92b27c9d6c4927574
# Optional explicit addresses (no key needed) for non-signing roles
# PROPOSER_ADDRESS=0x...
# VOTER1_ADDRESS=0x...
# VOTER2_ADDRESS=0x...
# VOTER3_ADDRESS=0x...
# GUARDIAN_ADDRESS=0x...
# VERIFIER_ADDRESS=0x...
# CHALLENGER_ADDRESS=0x...
DEV_WALLET_ADDRESS=0xAf1f2f642a44095Fb29eFF70760D0a5df3d8e354
# DEV_WALLET_KEY=0x...
VENDOR_ADDRESS=0xC6969cfeE3c456458f957264584c5a047b5e6b8E
# VENDOR_KEY=0x...

# ── Testnet timing (seconds). Ignored defaults: local stays 3600/259200 ──
TIMELOCK_DELAY_SECONDS=120
MAX_DELAY_SECONDS=1209600
VOTING_PERIOD_SECONDS=300
CHALLENGE_WINDOW_SECONDS=1800
CHALLENGE_EXTENSION_SECONDS=3600
QUORUM_TOKENS=1000
GOV_TOKEN_MINT_TOKENS=1000

# ── Sepolia fork (Sentinel simulation + hardhat network) ──
# Set FORK=1 only for the Sentinel session; it changes the hardhat network to
# a Sepolia fork for every command in that shell.
# FORK=1
# FORK_BLOCK_NUMBER=
# LOCAL_RPC_URL=http://127.0.0.1:8545

# ── Next.js console (app/) ──
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/<your-key>
# RPC_URL=                  # server-side override used by app/lib/chain.ts
# AEGIS_DEPLOYMENT=local   # force a manifest when CHAIN_ID is not 1/11155111/31337
# ALLOW_DEV_SIGNER=1       # local Hardhat only; ignored on Sepolia

# ── Sentinel ──
SENTINEL_NETWORK=sepolia
SENTINEL_POLL_MS=12000
SENTINEL_LOG_CHUNK=2000
# SENTINEL_FROM_BLOCK=      # defaults to the deployment block in the manifest
# SENTINEL_RPC_URL=         # defaults to SEPOLIA_RPC_URL
# SENTINEL_HALT_RPC_URL=    # halt provider; defaults to SEPOLIA_RPC_URL

# ── Pre-vote effect preview ──
# PREVIEW_RPC_URL=          # overrides RPC_URL for the preview CLI only
# PREVIEW_NO_CACHE=1        # skip the (proposalId, blockNumber) preview cache

# ── Seeder ──
SEED_POLL_MS=10000
P2_HALT_TIMEOUT_SECONDS=600
# SEED_ALLOW_DIRECT_HALT=0  # 1 = let the seeder send the guardian halt itself
